{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/games/pantheon-wars/titan-cron?event=morning", "schedule": "0 13 * * *" },
    { "path": "/api/games/pantheon-wars/titan-cron?event=evening", "schedule": "0 1 * * *" }
  ]
}
